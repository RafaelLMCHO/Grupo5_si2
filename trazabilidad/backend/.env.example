APP_NAME=Sistema de Trazabilidad
ENVIRONMENT=development

# URL de conexión a la Base de Datos PostgreSQL de Supabase
# Ejemplo con Pooler: postgresql+psycopg://postgres.[PROJECT-REF]:[TU-CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:rafa@localhost:5432/Blockchain

JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

RESET_TOKEN_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8000,http://127.0.0.1:8000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Google Gemini API Key
GEMINI_API_KEY=

# Supabase Storage (para respaldos cifrados en la nube)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BACKUP_BUCKET=tenant-backups
